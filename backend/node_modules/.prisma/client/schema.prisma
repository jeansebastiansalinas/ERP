generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  VENDEDOR
  COMPRADOR
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  name         String?
  isActive     Boolean @default(true)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔁 Relación inversa
  orders Order[] @relation("UserOrders")
}

model Client {
  id           Int      @id @default(autoincrement())
  businessName String
  taxId        String   @unique
  country      String
  city         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // 🔁 Relación inversa
  orders Order[]
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Decimal
  unit      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // 🔁 Relación inversa
  orders Order[]
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  DELIVERED
}

model Order {
  id Int @id @default(autoincrement())

  quantity   Float
  totalPrice Float

  status OrderStatus @default(PENDING)

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  createdById Int
  createdBy   User @relation("UserOrders", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  invoice Invoice?
}

model Invoice {
  id Int @id @default(autoincrement())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id])

  clientName  String
  productName String
  unitPrice   Decimal
  quantity    Float
  totalAmount Decimal

  createdAt DateTime @default(now())
}
